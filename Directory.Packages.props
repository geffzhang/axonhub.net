<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- 管理面 GraphQL：HotChocolate 16（前端固定 POST /admin/graphql） -->
    <PackageVersion Include="HotChocolate.AspNetCore" Version="16.8.0-p.9" />
    <!-- 指标：参照 internal/metrics 的 OTel SDK（stdout / OTLP gRPC / OTLP HTTP，5 秒周期） -->
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <!-- Actor 框架：NuGet 发布包，不引用 E:\GitHub\orleans 源码 -->
    <PackageVersion Include="Microsoft.Orleans.Sdk" Version="10.4.1" />
    <PackageVersion Include="Microsoft.Orleans.Server" Version="10.4.1" />
    <PackageVersion Include="Microsoft.Orleans.Client" Version="10.4.1" />
    <PackageVersion Include="Microsoft.Orleans.Reminders" Version="10.4.1" />
    <PackageVersion Include="Microsoft.Orleans.TestingHost" Version="10.4.1" />
    <PackageVersion Include="Microsoft.Orleans.Serialization.SystemTextJson" Version="10.4.1" />
    <!-- 持久化：CQRS 分工——写侧 EF Core，读侧 Dapper；PostgreSQL（本地参考 E:\GitHub\Dapper @ 2.1.89） -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- HTTP 入口：zstd 请求体解压（klauspost/compress 的托管移植） -->
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
    <!-- 密码哈希：参照内部使用 golang.org/x/crypto/bcrypt（cost 10，$2a$，hex 编码） -->
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.0" />
    <!-- 备份存储：S3 用官方 SDK（参照 aws-sdk-go-v2）；GCS/WebDAV 走 HTTP，见 Storage/ -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.20.4" />
    <!-- Anthropic 初始 input usage 估算：参照 tiktoken-go 的 o200k_base 词表 -->
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="3.0.0" />
    <!-- 配置：config.yml 与参照实现的 YAML 配置文件兼容 -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- 测试 -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
